					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"const queryParams = pm.iterationData.get(\"queryParams\") || {};\r",
									"\r",
									"//Did not work in Newman CLI\r",
									"// const queryString = Object.keys(queryParams).length\r",
									"//   ? \"?\" + new URLSearchParams(queryParams).toString()\r",
									"//   : \"\";\r",
									"const toQueryString = (params) =>\r",
									"  Object.entries(params)\r",
									"    .map(([k, v]) => `${encodeURIComponent(k)}=${encodeURIComponent(v)}`)\r",
									"    .join(\"&\");\r",
									"\r",
									"// Example\r",
									"const queryString = toQueryString(queryParams);\r",
									"\r",
									"pm.variables.set(\"requestUrl\", \"?\" + queryString);\r",
									"pm.variables.set(\"expectedStatus\", pm.iterationData.get(\"statusCode\"));\r",
									"pm.variables.set(\"expectedResult\", pm.iterationData.get(\"result\"));\r",
									"pm.variables.set(\"expectedError\", pm.iterationData.get(\"error\") || \"\");\r",
									"\r",
									""
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"function getAllProductsRespSchema() {\r",
									"    return {\r",
									"        type: \"array\",\r",
									"        items: {\r",
									"            type: \"object\",\r",
									"            properties: {\r",
									"                id: { type: \"integer\" },\r",
									"                category: { type: \"string\" },\r",
									"                name: { type: \"string\" },\r",
									"                inStock: { type: \"boolean\" }\r",
									"            },\r",
									"            required: [\"id\", \"category\", \"name\", \"inStock\"]\r",
									"        }\r",
									"    };\r",
									"}\r",
									"const jsonData = pm.response.json();\r",
									"\r",
									"const expectedStatus = parseInt(pm.variables.get(\"expectedStatus\"), 10);\r",
									"const expectedResult = pm.variables.get(\"expectedResult\");\r",
									"const expectedError = pm.variables.get(\"expectedError\");\r",
									"\r",
									"\r",
									"\r",
									"if (expectedResult === \"error\") {\r",
									"    pm.test(\"Error message matches expected\", function () {\r",
									"        pm.response.to.have.status(expectedStatus);\r",
									"        pm.expect(jsonData.error).to.eql(expectedError);\r",
									"    });\r",
									"}\r",
									"\r",
									"if (expectedResult === \"success\") {\r",
									"    pm.test(\"Response contains data\", function () {\r",
									"        pm.response.to.have.status(expectedStatus);\r",
									"        pm.expect(jsonData).to.not.be.empty;\r",
									"    }); \r",
									"    pm.test(\"Response JSON Schema is valid\", function () {\r",
									"    pm.response.to.have.jsonSchema(getAllProductsRespSchema());\r",
									"\r",
									"});\r",
									"}\r",
									""
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
