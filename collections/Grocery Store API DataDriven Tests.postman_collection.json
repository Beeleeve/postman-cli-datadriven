				{
					"name": "Add an item to cart",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"function randomElement(array) {\r",
									"    return array[Math.floor(Math.random() * array.length)];\r",
									"}\r",
									"\r",
									"// const cartID = pm.collectionVariables.get(\"cartID\");\r",
									"// if(!cartID){\r",
									"//     pm.sendRequest({\r",
									"//             url: pm.variables.replaceIn('{{base_url}}/carts'),\r",
									"//             method: 'POST',\r",
									"//             header: { 'Content-Type': 'application/json' }\r",
									"//         }, function (err, res) {\r",
									"//             if (err) {\r",
									"//                 console.error(err);\r",
									"//                 return;\r",
									"//             }\r",
									"//             const json = res.json();\r",
									"//             pm.collectionVariables.set(\"cartID\", json.cartId);\r",
									"//     });\r",
									"// }\r",
									"\r",
									"const inStockIDs = JSON.parse(pm.collectionVariables.get(\"inStockProductIDs\"));\r",
									"const cartItemIDs = pm.collectionVariables.get(\"cartItemsProductIDs\");;\r",
									"const IDs = inStockIDs.filter(id => !cartItemIDs.includes(id));\r",
									"\r",
									"const randomProduct = randomElement(IDs);\r",
									"pm.variables.set(\"randomProductID\", randomProduct);\r",
									"\r",
									"const requestBody = pm.iterationData.get(\"body\");\r",
									"pm.variables.set(\"requestBody\", JSON.stringify(requestBody));\r",
									"pm.variables.set(\"expectedStatus\", pm.iterationData.get(\"statusCode\"));\r",
									"pm.variables.set(\"expectedResult\", pm.iterationData.get(\"result\"));\r",
									"pm.variables.set(\"expectedError\", pm.iterationData.get(\"error\") || \"\");\r",
									""
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"function addToCartRespSchema() {\r",
									"  return {\r",
									"    type: \"object\",\r",
									"    properties: {\r",
									"      created: { type: \"boolean\" },\r",
									"      itemId: { type: \"number\" }\r",
									"    },\r",
									"    required: [\"created\", \"itemId\"],\r",
									"    additionalProperties: false\r",
									"  };\r",
									"}\r",
									"const jsonResp = pm.response.json();\r",
									"\r",
									"const expectedStatus = parseInt(pm.variables.get(\"expectedStatus\"), 10);\r",
									"const expectedResult = pm.variables.get(\"expectedResult\");\r",
									"const expectedError = pm.variables.get(\"expectedError\");\r",
									"\r",
									"if (expectedResult === \"error\") {\r",
									"    pm.test(\"Error message matches expected\", function () {\r",
									"        pm.response.to.have.status(expectedStatus);\r",
									"        pm.expect(jsonResp.error).to.eql(expectedError);\r",
									"    });\r",
									"}\r",
									"\r",
									"if (expectedResult === \"success\") {\r",
									"    pm.test(\"Response contains data\", function () {\r",
									"        pm.response.to.have.status(expectedStatus);\r",
									"        pm.expect(jsonResp).to.not.be.empty;\r",
									"    }); \r",
									"    pm.test(\"Response JSON Schema is valid\", function () {\r",
									"    pm.response.to.have.jsonSchema(addToCartRespSchema());\r",
									"    let itemIDs =[];\r",
									"    itemIDs.push(jsonResp.itemId);\r",
									"    pm.collectionVariables.set(\"cartItemIDs\", JSON.stringify(itemIDs));\r",
									"\r",
									"});\r",
									"}\r",
									""
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
