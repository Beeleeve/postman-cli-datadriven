									"const jsonResp = pm.response.json();\r",
									"\r",
									"pm.test(\"Status code is 201\", function () {\r",
									"    pm.response.to.have.status(201);\r",
									"});\r",
									"\r",
									"pm.test(\"Response schema is valid\", function () {\r",
									"     pm.response.to.have.jsonSchema(createCartRespSchema());\r",
									"});\r",
									"\r",
									"pm.test(\"Cart created successfully\", function () {  \r",
									"    pm.expect(jsonResp.created).to.be.true;\r",
									"});\r",
									"\r",
									"pm.test(\"Cart ID is returned\", function () {\r",
									"    pm.expect(jsonResp.cartId).to.be.a('string');\r",
									"});\r",
									"pm.collectionVariables.set(\"cartID\", jsonResp.cartId);\r",
									"pm.collectionVariables.get(\"cartID\");"
